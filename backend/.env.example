# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://user:password@localhost:5432/timetable_db
# SQLite (local dev — uncomment and comment out the line above)
# DATABASE_URL=sqlite:///./dev.db

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-replace-with-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookie Security ───────────────────────────────────────────────────────────
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
# Options: lax | strict | none  (use strict in production)
COOKIE_SAMESITE=lax
# Leave empty for localhost; set to your domain in production (e.g. example.com)
COOKIE_DOMAIN=

# ── LLM / Groq ────────────────────────────────────────────────────────────────
# Comma-separated list of Groq API keys (key rotation pool)
GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2
GROQ_MODEL=openai/gpt-oss-120b

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Admin Seed (first startup only) ──────────────────────────────────────────
# Used ONLY at first startup to create the initial ADMIN user.
# Change immediately after first login.
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=CHANGE_ME_NOW_STRONG_PASSWORD
ADMIN_FULL_NAME=Administrator

# ── Demo Teacher Seed (optional, first startup only) ─────────────────────────
# Password used for ALL seeded demo teacher accounts.
# Change via Admin Panel after first login.
# DO NOT use in production with a weak password.
DEMO_TEACHER_PASSWORD=teacher-CHANGE-ME-123

# Optional: JSON array to override built-in demo teachers.
# Leave empty to use built-in defaults (sk@college.edu, sc@college.edu, etc.)
# SEED_TEACHERS=[{"email":"sk@college.edu","name":"SK"},{"email":"sc@college.edu","name":"SC"}]
SEED_TEACHERS=

# ── Login Rate Limiting ───────────────────────────────────────────────────────
# Number of consecutive wrong passwords before account lockout
LOGIN_MAX_ATTEMPTS=5
# How long (minutes) the account stays locked after too many failures
LOGIN_LOCKOUT_MINUTES=15
