# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:GnYbI1NcTi1HrKhI@db.cevdlzpgrplcczxlgjkw.supabase.co:5432/postgres

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_IN_RENDER_ENV_VARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookie Security (HTTPS in production) ─────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=

# ── LLM / Groq ────────────────────────────────────────────────────────────────
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b

# ── CORS (replace with your Vercel frontend URL) ──────────────────────────────
CORS_ORIGINS=https://your-app.vercel.app

# ── Admin Seed (first startup only) ──────────────────────────────────────────
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@1234
ADMIN_FULL_NAME=Administrator

# ── Demo Teacher Seed ─────────────────────────────────────────────────────────
DEMO_TEACHER_PASSWORD=Teacher@1234
SEED_TEACHERS=

# ── Login Rate Limiting ───────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
